# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local: RUST_INGRESS_URL=http://127.0.0.1:8080
# Preview: RUST_INGRESS_URL=https://canonflo-api.fly.dev
# Production: RUST_INGRESS_URL=https://api.canonflo.com
RUST_INGRESS_URL=http://127.0.0.1:8080

# Convex provider
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk provider
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_replace-with-clerk-secret-key
# Optional: set true to enable Clerk scripts during local development.
NEXT_PUBLIC_ENABLE_CLERK_IN_DEV=false

# Postmark provider (optional local webhook auth)
POSTMARK_WEBHOOK_SECRET=replace-with-shared-secret

# Rust ingress -> Convex forwarding (set in Rust service environment)
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_ADMIN_KEY=replace-with-convex-admin-key

# Seed script defaults (optional overrides)
SEED_TEST_LOGIN_EMAIL=sim.tester@canonflo.local
SEED_TEST_LOGIN_PASSWORD=SimTester#2026
SEED_TEST_LOGIN_FIRST_NAME=Simulation
SEED_TEST_LOGIN_LAST_NAME=Tester
