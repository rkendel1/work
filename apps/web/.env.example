# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
RUST_INGRESS_URL=http://127.0.0.1:8080

# Convex provider
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk provider
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_replace-with-clerk-secret-key

# Postmark provider (optional local webhook auth)
POSTMARK_WEBHOOK_SECRET=replace-with-shared-secret

# Rust ingress -> Convex forwarding (set in Rust service environment)
CONVEX_DEPLOYMENT_URL=https://your-deployment.convex.cloud
CONVEX_ADMIN_KEY=replace-with-convex-admin-key
